
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bingo</title>

  <script src="https://telegram.org/js/telegram-web-app.js"></script>

  <style>
    body {
      margin: 0;
      padding: 20px;
      font-family: Arial, sans-serif;
      background: #f2f2f2;
      text-align: center;
    }

    h1 {
      margin-bottom: 5px;
    }

    .subtitle {
      color: #666;
      margin-bottom: 20px;
    }

    .bingo-board {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 6px;
      max-width: 400px;
      margin: auto;
    }

    .cell {
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: white;
      border-radius: 8px;
      font-size: 18px;
      font-weight: bold;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .header {
      background: #2196f3;
      color: white;
    }

    .free {
      background: #4caf50;
      color: white;
    }

    button {
      margin-top: 25px;
      padding: 14px 25px;
      border: none;
      border-radius: 10px;
      font-size: 17px;
      font-weight: bold;
      background: #2196f3;
      color: white;
    }
  </style>
</head>

<body>

  <h1>🎱 Bingo</h1>

  <div class="subtitle">
    Your Bingo Card
  </div>

  <div class="bingo-board">

    <div class="cell header">B</div>
    <div class="cell header">I</div>
    <div class="cell header">N</div>
    <div class="cell header">G</div>
    <div class="cell header">O</div>

    <div class="cell">1</div>
    <div class="cell">17</div>
    <div class="cell">34</div>
    <div class="cell">49</div>
    <div class="cell">67</div>

    <div class="cell">5</div>
    <div class="cell">21</div>
    <div class="cell">39</div>
    <div class="cell">53</div>
    <div class="cell">72</div>

    <div class="cell">8</div>
    <div class="cell">25</div>
    <div class="cell free">FREE</div>
    <div class="cell">57</div>
    <div class="cell">69</div>

    <div class="cell">11</div>
    <div class="cell">28</div>
    <div class="cell">41</div>
    <div class="cell">46</div>
    <div class="cell">74</div>

    <div class="cell">14</div>
    <div class="cell">30</div>
    <div class="cell">44</div>
    <div class="cell">59</div>
    <div class="cell">75</div>

  </div>

  <button onclick="closeApp()">Close</button>

  <script>
    const tg = window.Telegram.WebApp;

    tg.ready();
    tg.expand();

    function closeApp() {
      tg.close();
    }
  </script>

</body>
</html>
